{% extends 'base.html.twig' %}

{% block title %}New Book - Community Library{% endblock %}

{% block body %}
    <h1>New Book</h1>

    {{ form_start(form) }}
    {{ form_row(form.title) }}
    {{ form_row(form.isbn) }}
    {{ form_row(form.summary) }}
    {{ form_row(form.publicationDate) }}
    {% if form.available is defined %}
        {{ form_row(form.available) }}
    {% endif %}
    {{ form_row(form.language) }}
    {{ form_row(form.coverUrl) }}
    {{ form_row(form.authors) }}
    {{ form_row(form.genres) }}

    <button type="submit">Create Book</button>
    {{ form_end(form) }}

    <a href="{{ path('app_book_index') }}">← Back to books</a>
{% endblock %}
