{% extends 'base.html.twig' %}

{% block title %}{{ book.title }} - Community Library{% endblock %}

{% block body %}
    <h1>{{ book.title }}</h1>

    <div class="book-meta">
        {% for author in book.authors %}
            <span><a href="{{ path('app_author_show', {id: author.id}) }}">{{ author.name }}</a></span>
        {% endfor %}
        {% if book.publicationDate %}<span>{{ book.publicationDate|date('Y') }}</span>{% endif %}
        {% for genre in book.genres %}
            <span class="genre-badge">{{ genre.name|upper }}</span>
        {% endfor %}
    </div>

    {% if book.coverUrl %}
        <img src="{{ book.coverUrl }}" alt="Cover of {{ book.title }}" width="200">
    {% endif %}

    <hr>

    {% if book.summary %}<p>{{ book.summary }}</p>{% endif %}

    <p>
        {{ book.available ? 'Available' : 'Currently borrowed' }}
        {% if book.isbn %} &middot; ISBN {{ book.isbn }}{% endif %}
    </p>

    <a href="{{ path('app_book_index') }}" class="btn btn-outline-secondary">← Back to all books</a>
{% endblock %}
